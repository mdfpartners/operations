# ── QuickBooks Time ─────────────────────────────────────────────────────────
# Generate at: https://tsheets.intuit.com/api/v1/apps (Settings → App Management)
QBT_ACCESS_TOKEN=your_quickbooks_time_api_token_here

# ── Microsoft / OneDrive ─────────────────────────────────────────────────────
# Create an app at https://portal.azure.com → Azure Active Directory → App registrations
# Required API permissions: Files.ReadWrite (delegated) or Files.ReadWrite.All (application)
AZURE_CLIENT_ID=your_azure_app_client_id
AZURE_CLIENT_SECRET=your_azure_app_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# ── Spreadsheet location ─────────────────────────────────────────────────────
# Path to the Excel file inside OneDrive, e.g. "Reports/Time Report.xlsx"
ONEDRIVE_FILE_PATH=Reports/Time Report.xlsx

# ── Sync settings ───────────────────────────────────────────────────────────
# Days back to pull (default 1 = yesterday). Override with --days flag.
DEFAULT_DAYS_BACK=1
